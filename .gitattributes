# Normalise line endings to LF in the repository and in every checkout.
# The project is developed on Windows, macOS and Linux, and a diff that shows
# every line as changed because of CRLF is noise.
* text=auto eol=lf

# Keep shell style scripts executable.
*.sh text eol=lf
*.mjs text eol=lf

# Binary assets are never rewritten.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
